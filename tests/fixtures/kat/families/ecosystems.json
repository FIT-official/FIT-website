    {
      "id": "web-pond",
      "desc": "pond food web: producers, tops, chains",
      "op": "food_web",
      "sim": "ecosystems",
      "sim_hook": "FITCalcEco.food_web",
      "input": {
        "organisms": [
          "algae",
          "water flea",
          "small fish",
          "heron",
          "frog",
          "pond weed",
          "snail"
        ],
        "eats": [
          [
            "water flea",
            "algae"
          ],
          [
            "small fish",
            "water flea"
          ],
          [
            "heron",
            "small fish"
          ],
          [
            "heron",
            "frog"
          ],
          [
            "frog",
            "snail"
          ],
          [
            "snail",
            "pond weed"
          ],
          [
            "snail",
            "algae"
          ],
          [
            "small fish",
            "snail"
          ]
        ]
      },
      "expected": {
        "producers": [
          "algae",
          "pond weed"
        ],
        "top_consumers": [
          "heron"
        ],
        "chain_count": 5,
        "longest_chain": 4,
        "max_trophic_level": {
          "algae": 1,
          "water flea": 2,
          "small fish": 3,
          "heron": 4,
          "frog": 3,
          "pond weed": 1,
          "snail": 2
        }
      },
      "edge": false,
      "hand_check": "producers algae, pond weed; top heron; chains: algae-flea-fish-heron, algae-snail-fish-heron, algae-snail-frog-heron, weed-snail-fish-heron, weed-snail-frog-heron = 5; longest 4"
