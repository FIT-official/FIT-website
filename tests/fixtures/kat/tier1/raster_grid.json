          [
            0.1111111111111111,
            0.1111111111111111,
            0.1111111111111111
          ],
          [
            0.1111111111111111,
            0.1111111111111111,
            0.1111111111111111
          ],
          [
            0.1111111111111111,
            0.1111111111111111,
            0.1111111111111111
